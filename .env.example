# ═══════════════════════════════════════════════════════════════
# YouthConnect Bible Quiz - Environment Variables
# Copy this to .env.local and fill in the values
# ═══════════════════════════════════════════════════════════════

# ─── Pusher (Real-time) ─────────────────────────────────────────
# Create app at https://dashboard.pusher.com/ → Channels → Create app
# Free tier: 100 connections, 200k messages/day
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ─── Database (Neon Postgres) ───────────────────────────────────
# Create database at https://neon.tech
# Format: postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# ─── Auth.js (NextAuth) ─────────────────────────────────────────
# Generate secret: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth - https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Yandex OAuth - https://oauth.yandex.ru/
# 1. Create new app
# 2. Add redirect URI: https://yourdomain.com/api/auth/callback/yandex
# 3. Request access to: login:email, login:info
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# ─── Stripe (Donations) ─────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com
# For testing: use keys from Test mode
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment/Donation Links (create in Stripe Dashboard → Payment Links)
NEXT_PUBLIC_STRIPE_DONATE_LINK=

# ─── Alternative Donation Links ─────────────────────────────────
# PayPal.me link
NEXT_PUBLIC_PAYPAL_DONATE_LINK=

# Boosty page for Russia/CIS (no payment processing, just link)
NEXT_PUBLIC_BOOSTY_LINK=

# Crypto donation link (e.g., nowpayments.io or direct wallet)
NEXT_PUBLIC_CRYPTO_LINK=

# ─── Feature Flags ──────────────────────────────────────────────
# Set to "true" to show text quizzes (currently hidden, selfie-only mode)
NEXT_PUBLIC_ENABLE_TEXT_QUIZZES=false

# ─── Optional ───────────────────────────────────────────────────
# Custom domain for canonical URLs (default: youthconnect.church)
NEXT_PUBLIC_DOMAIN=youthconnect.church

# Analytics (Vercel Analytics is auto-enabled on Vercel)
# For self-hosted: add Plausible or Umami keys here
